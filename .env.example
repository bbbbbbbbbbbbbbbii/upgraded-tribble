# Rename this file to ".env" and fill in your bot token.
DISCORD_TOKEN=your_bot_token_here

# Optional: link shown in /help and @Bot help. Leave empty to hide that button.
SUPPORT_SERVER_URL=

# Optional wide banner image at the bottom of the help menu. Leave empty to skip it.
HELP_BANNER_URL=

# ---- Lavalink (music) ----
# The bot connects to this Lavalink v4 node for ALL music playback — no
# yt-dlp, no ffmpeg on the bot host. See README "Music (Lavalink) setup".
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
# true if your node is behind HTTPS/WSS (e.g. a reverse proxy with TLS)
LAVALINK_SECURE=false
